// __multiversion__

#if __VERSION__ >= 300
	#define varying in
	out vec4 FragColor;
	#define gl_FragColor FragColor
#endif

#include "config_utilities/color.h"
#include "utilities/sky_gradient.glsl"
#include "config_utilities/effects.h"

varying vec3 zenith_color;
varying vec3 horizon_color;
varying vec3 horizon_edge_color;
varying vec3 wPos;

// declared locally like FOG_COLOR in sky.vertex: the sky pass does not include
// the shader constants header
uniform highp float TIME;

void main(){
	float len = sqrt(dot(wPos.xyz,wPos.xyz));
	float sphereY = max(0.0,wPos.y/len);

	#if defined(SUN_SHAFTS) || defined(MILKY_WAY) || defined(SHOOTING_STARS)
		// only normalized when an effect actually needs the direction
		vec3 dir = wPos/len;
	#endif

	vec3 skyColor = renderSky(horizon_edge_color,horizon_color,zenith_color,sphereY);

	#ifdef SUN_SHAFTS
		// there is no sun direction uniform on this pipeline, so the shafts are
		// anchored to the horizon: azimuthal bands gated by how warm the horizon
		// colour is, which is exactly when you want to see them
		vec2 azim = normalize(vec2(dir.x,dir.z)+vec2(1e-4));
		float warm = clamp(horizon_color.r-horizon_color.b*0.8,0.0,1.0);
		float shafts = sin(dot(azim,vec2(11.0,7.0)) + sin(dot(azim,vec2(3.0,5.0))*2.0));
		shafts = max(shafts,0.0);
		shafts *= shafts;
		float lift = smoothstep(0.0,0.6,1.0-sphereY);
		skyColor += horizon_color*SUN_SHAFTS*warm*shafts*lift*1.3;
	#endif

	#ifdef MILKY_WAY
		// faint procedural band above the horizon: two cheap sines and a mask,
		// gated by how dark the sky already is so it never shows at noon
		float skyDark = clamp(1.0-max(max(zenith_color.r,zenith_color.g),zenith_color.b)*1.7,0.0,1.0);
		float bandAxis = dot(dir,vec3(0.344,0.541,0.767));
		float bandMask = 1.0-smoothstep(0.0,0.5,abs(bandAxis));
		float grain = sin(dot(dir.xy,vec2(37.0,23.0)))*0.5+0.5;
		grain *= sin(dot(dir.yz,vec2(19.0,41.0)))*0.5+0.5;
		skyColor += vec3(0.55,0.62,0.92)*MILKY_WAY*bandMask*grain*skyDark*max(sphereY,0.0);
	#endif

	#ifdef SHOOTING_STARS
		// two meteors on fixed paths. No texture, no varying, and only sky pixels
		// pay for it. The sky brightness gate keeps them out of the daytime.
		float meteorSky = clamp(1.0-max(max(zenith_color.r,zenith_color.g),zenith_color.b)*2.2,0.0,1.0);
		vec2 plane = vec2(dot(dir,vec3(0.87,0.0,0.49)), dir.y);
		for(int i=0;i<2;i++){
			float fi = float(i);
			float cycle = fract(TIME*(0.32+fi*0.11) + fi*0.73);
			vec2 head = vec2(-0.35+fi*0.55+cycle*1.1, 0.35+fi*0.22-cycle*0.5);
			vec2 tail = head-vec2(0.16,-0.07);
			vec2 pa = plane-head;
			vec2 ba = tail-head;
			float hSeg = clamp(dot(pa,ba)/dot(ba,ba),0.0,1.0);
			float dist = length(pa-ba*hSeg);
			float bright = (1.0-smoothstep(0.0,0.05,dist))*(1.0-smoothstep(0.05,0.35,abs(cycle-0.5)))*meteorSky;
			skyColor += vec3(0.85,0.92,1.0)*SHOOTING_STARS*bright;
		}
	#endif

	skyColor = colorCorrection(skyColor);

	gl_FragColor = vec4(skyColor,1.0);
}
