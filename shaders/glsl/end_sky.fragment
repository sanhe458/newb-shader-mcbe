// __multiversion__

#include "fragmentVersionCentroid.h"

#if __VERSION__ >= 300
	#if defined(TEXEL_AA) && defined(TEXEL_AA_FEATURE)
		_centroid in highp vec2 uv;
	#else
		_centroid in vec2 uv;
	#endif
#else
	varying vec2 uv;
#endif

#include "uniformShaderConstants.h"
#include "util.h"
#include "config_utilities/effects.h"

varying vec3 horizon_color;
varying vec3 pos;

LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0;

void main(){
	#if !defined(TEXEL_AA) || !defined(TEXEL_AA_FEATURE)
		vec4 diffuse = texture2D( TEXTURE_0, uv );
	#else
		vec4 diffuse = texture2D_AA(TEXTURE_0, uv );
	#endif

	float sphereY = pos.y/sqrt(dot(pos.xyz,pos.xyz));
	float grad = 1.0-max(sphereY,0.0);
	grad *= grad;

	// end sky gradient
	vec3 color = horizon_color*smoothstep(0.0,1.0,grad);

	float starMask = 1.0-grad*grad; // stars
	#ifdef STAR_TWINKLE
		// the stars are a texture here, they cannot move: the twinkle is a per
		// pixel shimmer whose phase comes from the uv, so some fade in and out
		float tw = 0.5+0.5*sin(TIME*2.2 + uv.x*63.0 + uv.y*47.0);
		tw *= tw*tw;
		starMask *= 1.0-STAR_TWINKLE*tw;
	#endif
	color += diffuse.rgb*starMask;

	// end void gradient
	float glow = max((-sphereY-0.5)*2.0,0.0);
	color += horizon_color*glow*glow*glow;

	gl_FragColor = vec4(color,1.0);
}
